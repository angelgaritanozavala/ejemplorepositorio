@import url('https://fonts.googleapis.com/css2?family=Montserrat+Alternates:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap');
*{
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    list-style:none ;
    text-decoration: none;
}
:root{
    --bg_header:rgba(239, 239, 239, 1);
    --stroke:rgba(233, 61, 61, 1);
    --primary:rgba(164, 128, 128, 1);
    --fontprincipal:"Montserrat Alternates", sans-serif;
    --white:#fff;
    --black:#000;
    --s8: 8px;
    --s16: 16px;
    --s24: 24px;
    --s32: 32px;
    --s40: 40px;
    --s48: 48px;
    --s56: 56px;
    --s64: 64px;
    --s72: 72px;
    --nav-gap: var(--s16);
    --btn-padding-x: var(--s40);
    --btn-padding-y: var(--s16);
    

}
body{
    font-family: var(--fontprincipal);
    --title_m:39px;
    --title_sm: 35px;
    --body_l:20px;

}
.site-header{
    background-color: var(--bg_header);
    border-bottom: 2px solid var(--stroke);
    padding:var(--s32);
    display: flex;
    justify-content: space-between;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
}
.site-header h1{}
.site-header .main-navigation{}
.site-header .main-navigation .main-menu{
    display: flex;
    gap: var(--nav-gap);

    

   
}
.site-header .main-navigation .main-menu .menu-item{}
.site-header .main-navigation .main-menu .menu-item a{
background-color: var(--white);
padding:var(--btn-padding-y) var(--btn-padding-x);
display: inline-block;
color: var(--black);
border-radius: 55px;

}
.site-header .main-navigation .main-menu .menu-item a:hover{
background-color: var(--primary);
}
.main-content{
    margin-top: 117px;
    background: url("assets/images/fondo.png");
    
    
}
.main-content section{
    width: 1200px;
    background-color: #fff;
    padding: var(--s32);
    border-left: 1px solid var(--black) ;
    border-right: 1px solid var(--black) ;
    margin: 0 auto; 

}
.main-content .course-description{
    height: 683px;
    background: var(--primary);
    color: #fff;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--s24);
}
.course-description h2{
    font-size:var(--title_m);


}

.course-description div{
    width: 688px;
    font-size: var(--body_l);
    display: flex;
    flex-direction: column;
    gap:var(--s16) ;
 }
.students-grid{
    display: flex;
    flex-wrap: wrap;
    gap:var(--s24) ;
    justify-content: space-between;
}
.students-grid .student-card{
    display: flex;
    flex-wrap: wrap;

    border: 1px solid black ;
    border-radius:var(--s16) ;
    overflow: hidden;
    
}
.students-grid .student-card a{ 
    width: 263px;
    height: 110px;
    padding: var(--s24);
    transition: all 300ms;
    background:url("assets/images/icons8-flecha-50.png")no-repeat 213px center;
    display: flex;
    flex-direction: column;
    justify-content: center;


}  
.students-grid .student-card a :hover{ 
    background-color: burlywood url("assets/images/icons8-flecha-50.png")no-repeat 213px center;
} 
.students-grid .student-card h3{
    font-size: var(--title_sm);
    width: 179px;


}   

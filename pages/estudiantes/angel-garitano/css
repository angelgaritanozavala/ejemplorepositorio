*{
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    list-style:none ;
    text-decoration: none;
}
:root{
    --bg_header:rgba(239, 239, 239, 1);
    --stroke:rgba(233, 61, 61, 1);
    --primary:rgba(164, 128, 128, 1);
    --fontprincipal:"arial" ,sans-serif;
    --white:#fff;
    --black:#000;

}
body{
    font-family: var(--fontprincipal);
}
.site-header{
    background-color: var(--bg_header);
    border-bottom: 2px solid var(--stroke);
    padding:32px;
    display: flex;
}
.site-header h1{}
.site-header .main-navigation{}
.site-header .main-navigation .main-menu{
    display: flex;
    gap: 10px;

   
}
.site-header .main-navigation .main-menu .menu-item{}
.site-header .main-navigation .main-menu .menu-item a{
background-color: var(--white);
padding: 15px 40px;
display: inline-block;
color: var(--black);


}
.site-header .main-navigation .main-menu .menu-item a:hover{
background-color: var(--primary);
}